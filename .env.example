# Copy to .env if you need to override defaults. Do not put secrets in images.
# Hugging Face token is optional: Waypoint-1.5-1B checkpoints are public.

# WAYPOINT_MODEL=Overworld/Waypoint-1.5-1B-360P
# WAYPOINT_QUANT=
# BIND_HOST=127.0.0.1
# PUBLIC_PORT=8790
# BACKEND_PORT=8791

# If this host uses an HTTP proxy for outbound downloads, Compose forwards:
# HTTP_PROXY / HTTPS_PROXY / NO_PROXY from the environment.
