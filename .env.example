# Copy to .env. Do not commit .env or real tokens.
# Compose interpolates this file and passes HF_TOKEN into the GPU container.

HF_TOKEN=
HUGGING_FACE_HUB_TOKEN=

# Waypoint world model (Apache-2.0). Default is 360p; UI can switch to 720p.
# WAYPOINT_MODEL=Overworld/Waypoint-1.5-1B-360P
# WAYPOINT_QUANT=

# Gemma 4 E4B + FLUX.2-klein-4B scene authoring (1=on). Extra HF downloads
# land in data/hf-cache/ on the host (bind-mounted; survives image rebuilds).
SCENE_AUTHORING=1

# Host outbound proxy is not reachable at 10.1.1.100 from the Docker bridge.
# Compose hard-codes http://host.docker.internal:3128 for the GPU service.
# HTTP_PROXY=
# HTTPS_PROXY=
# NO_PROXY=localhost,127.0.0.1,backend
