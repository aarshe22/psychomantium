# Copy to .env. Do not commit .env or real tokens.
# Compose interpolates this file and passes HF_TOKEN into the GPU container.

HF_TOKEN=
HUGGING_FACE_HUB_TOKEN=

# Waypoint world model (Apache-2.0). Default is 360p; UI can switch to 720p.
# WAYPOINT_MODEL=Overworld/Waypoint-1.5-1B-360P
# WAYPOINT_QUANT=

# Gemma 4 E4B + FLUX.2-klein-4B scene authoring (1=on). Extra HF downloads
# land in data/hf-cache/ on the host (bind-mounted; survives image rebuilds).
SCENE_AUTHORING=1

# Optional HTTP(S) proxy for Hugging Face weight downloads
# (./scripts/pre-cache-models on the host). Leave unset/commented for direct.
# Compose interpolates these for image *builds*. The running GPU service still
# uses http://host.docker.internal:3128 because 10.1.1.100 is not reachable
# from the Docker bridge — change compose.yaml if your proxy is elsewhere.
# HTTP_PROXY=http://127.0.0.1:3128
# HTTPS_PROXY=http://127.0.0.1:3128
# NO_PROXY=localhost,127.0.0.1,backend
# http_proxy=http://127.0.0.1:3128
# https_proxy=http://127.0.0.1:3128
# no_proxy=localhost,127.0.0.1,backend
